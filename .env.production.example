# ═══════════════════════════════════════════════════════════════════════
#  MapeLearn — Production Environment Configuration
#  Copy this file to .env on your cPanel server and fill in real values.
#  NEVER commit your real .env file to git.
# ═══════════════════════════════════════════════════════════════════════

APP_NAME="MapeLearn"
APP_ENV=production
APP_KEY=                          # Run: php artisan key:generate
APP_DEBUG=false                   # MUST be false in production
APP_URL=https://mapelead.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ─── Database (MySQL for production) ────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_strong_db_password

# ─── Cache & Session (use Redis in production, or database) ─────────────
CACHE_STORE=database              # Change to 'redis' if Redis available
CACHE_PREFIX=mapelead_

SESSION_DRIVER=database           # Change to 'redis' if Redis available
SESSION_LIFETIME=120
SESSION_ENCRYPT=true              # Enable in production
SESSION_SECURE_COOKIE=true        # Requires HTTPS

# ─── Queue ───────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database         # Use 'redis' if Redis available

# ─── Mail (Mailgun / SMTP / SES) ─────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_mailgun_smtp_login
MAIL_PASSWORD=your_mailgun_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@mapelead.org"
MAIL_FROM_NAME="MapeLearn"

# Alternatively, use Postmark:
# MAIL_MAILER=postmark
# POSTMARK_TOKEN=your_postmark_token

# ─── Google OAuth ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://mapelead.org/auth/google/callback

# ─── Payment Gateways ────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxx-X

# ─── OTP Settings ────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# ─── AWS S3 (optional, for file storage) ────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false
# FILESYSTEM_DISK=s3
