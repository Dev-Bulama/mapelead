APP_NAME="MapeLearn"
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── DATABASE ────────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite
# For production MySQL, uncomment & fill:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mapelead
# DB_USERNAME=root
# DB_PASSWORD=your_password_here

# ─── SESSION ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# ─── CACHE ───────────────────────────────────────────────────────────────────
CACHE_STORE=database
CACHE_PREFIX=mapelead_

# ─── QUEUE ───────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ─── BROADCAST ───────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ─── FILESYSTEM ──────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ─── MAIL ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@mapelead.org"
MAIL_FROM_NAME="${APP_NAME}"

# ─── SOCIAL LOGIN ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# ─── THIRD-PARTY INTEGRATIONS ────────────────────────────────────────────────
GOOGLE_ANALYTICS_ID=
META_PIXEL_ID=
TAWKTO_SITE_ID=
CHATBASE_ID=

# ─── PAYMENT GATEWAYS ────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here

# ─── OTP ─────────────────────────────────────────────────────────────────────
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

VITE_APP_NAME="${APP_NAME}"
