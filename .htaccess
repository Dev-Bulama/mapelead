<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the request is not already targeting public/, rewrite it there
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Fallback for servers without mod_rewrite
<IfModule !mod_rewrite.c>
    ErrorDocument 403 /public/index.php
</IfModule>
